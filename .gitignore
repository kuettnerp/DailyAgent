# Runtime memory data is written to ~/.patriot/ (outside this repo),
# but guard against it ever being created in-tree during local testing.
/.patriot/
data/

__pycache__/
*.pyc
.env
.DS_Store

# voice daemon local env / generated plist (the .template is committed, the real one is per-machine)
voice/.venv/
voice/launchd/*.plist
!voice/launchd/*.plist.template

# wake-word training scratch space: venv + generated audio clips are not
# committed, only the final trained model under voice/models/ is
voice/training/.venv/
voice/training/audio/
voice/training/*.npy
voice/training/*.npz
