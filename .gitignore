# Runtime memory data is written to ~/.daily-assistant/ (outside this repo),
# but guard against it ever being created in-tree during local testing.
/.daily-assistant/
data/

__pycache__/
*.pyc
.env
.DS_Store

# voice daemon local env / generated plist (the .template is committed, the real one is per-machine)
voice/.venv/
voice/launchd/*.plist
!voice/launchd/*.plist.template
